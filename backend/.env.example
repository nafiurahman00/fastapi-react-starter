# Copy to ".env" (same folder as this file). Real environment variables win.

# MySQL (SQLAlchemy URL). Create the database first - see the root README.
DATABASE_URL=mysql+pymysql://appuser:apppass@localhost:3306/app_db

# CHANGE THIS in any real project. Min 32 characters.
JWT_SECRET=change-me-this-is-a-demo-secret-key-please-replace-32+chars
JWT_EXPIRATION_MINUTES=1440

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
